# Copy to ".env" next to the compose file. Both values are optional.

# Leave EMPTY to let anyone who can reach ZeroDash save changes from the editor.
# Set a password to require a login (HTTP basic auth) for SAVING only; viewing stays open.
# The password is hashed when the container starts.
ZERODASH_EDIT_PASSWORD=

# Login name used together with the password above (default: admin)
ZERODASH_EDIT_USER=admin

# ZeroDash default Caddyfile (baked into the image; needs the caddy-webdav build from Dockerfile.caddy).
# Override by mounting your own file at /etc/caddy/Caddyfile (see DOCKER.md for what it must contain).
{
	order webdav before file_server
}

http://:80 {
	root * /srv
	encode zstd gzip

	# Dashboard config, write side: the editor's Save button sends PUT.
	# /etc/caddy/zerodash.d/ is generated at start-up: empty (open) by default,
	# or a basic_auth login when ZERODASH_EDIT_PASSWORD is set.
	@save {
		method PUT
		path /user/data/*
	}
	handle @save {
		import /etc/caddy/zerodash.d/*.caddy
		webdav {
			root /srv
		}
	}

	# Dashboard config, read side.
	handle /user/data/* {
		header Cache-Control "no-store"
		file_server
	}

	handle {
		# Always revalidate so edits show up on refresh.
		header Cache-Control "no-cache"

		# /layout/<name> serves index.html, so its relative URLs (./main.js, ./core/...) resolve to
		# /layout/main.js, /layout/core/... -> map them back to the root.
		@layoutAssets path_regexp layoutAsset ^/layout/(.+\.[A-Za-z0-9]+)$
		rewrite @layoutAssets /{re.layoutAsset.1}

		# SPA fallback: /<layoutName> and /layout/<layoutName> must serve index.html.
		try_files {path} {path}/ /index.html
		file_server
	}
}

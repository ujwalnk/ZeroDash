FROM nginx:alpine

LABEL org.opencontainers.image.title="ZeroDash (nginx)" \
      org.opencontainers.image.description="Static homelab dashboard with in-browser editor, served by nginx"

# .dockerignore allows only the dashboard files, docker/ and icon.*; anything else is never sent to the build.
COPY . /usr/share/nginx/html/

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 docker/nginx/40-zerodash.sh /docker-entrypoint.d/40-zerodash.sh

# Starter dashboard lives outside the web root (so a mounted user/ directory can't hide it) and is
# copied into user/data/ on first start. Remove the build-only docker/ folder from the web root.
# (openssl is only used at start-up to hash ZERODASH_EDIT_PASSWORD.)
RUN apk add --no-cache openssl \
 && mkdir -p /usr/share/zerodash \
 && mv /usr/share/nginx/html/docker/default-data/dashboard.json /usr/share/zerodash/default-dashboard.json \
 && rm -rf /usr/share/nginx/html/docker \
 && printf 'allow all;\n' > /etc/nginx/zerodash-write-auth.conf

EXPOSE 80
